# MedAssist API Server Environment Configuration

# Server Environment & Port
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/medassist

# Security & Authentication Tokens
JWT_SECRET=medassist_clinical_jwt_secret_key_prod_2026
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=medassist_clinical_refresh_secret_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CORS_ORIGIN=http://localhost:3000

# AI Provider Integration (Optional live API keys; falls back to deterministic clinical models)
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Storage
UPLOAD_DIR=uploads
