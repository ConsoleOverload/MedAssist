# MedAssist Client Environment Configuration

# Base URL for API requests.
# Leave blank in development to use Vite local proxy (/api/v1).
# In production on separate domain (e.g. Vercel), set to your backend URL:
# Example: VITE_API_BASE_URL=https://medassist-api-xxxx.onrender.com/api/v1
# (Note: client.js also auto-corrects URLs if /api/v1 or trailing slashes were omitted)
VITE_API_BASE_URL=
